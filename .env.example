# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Leave the Supabase values empty to use local file storage and the single desk password.

# Project Settings -> API
SUPABASE_URL=https://vzxcqpgwvknonkhjinuk.supabase.co
# Project Settings -> API Keys -> Secret key (sb_secret_...). Server only; never put it in browser code.
SUPABASE_SECRET_KEY=

# Public address players will open; used for QR codes and secure cookies.
# PUBLIC_URL=https://carromia.example.org

# Hosting: listen on all interfaces instead of localhost only.
# HOST=0.0.0.0
# PORT=3000

# Optional Resend registration alerts. Recipients and on/off are in Event settings.
# For the live Pages site, configure these in Supabase -> Edge Functions -> Secrets.
# Use a sender on a domain verified in Resend; keep these values out of browser files.
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=
